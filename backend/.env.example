# LeadZam Backend Configuration Example
# Copy this file to .env or set environment variables in your terminal or IDE

# Server Port (default 8080)
PORT=8080

# Path to your Firebase service account JSON key downloaded from Firebase Console
# (Project Settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional: Default target device FCM token for local testing (Option A)
# If set, calls will be sent to this token when not provided in the dial request.
DEFAULT_DEVICE_FCM_TOKEN=

# Optional: Set to 'true' if running offline without a real Firebase project
# Simulates successful FCM message queuing for UI and API verification
FIREBASE_MOCK_MODE=false
